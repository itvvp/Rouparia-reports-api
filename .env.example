# SQL Server (host,porta) — preferir um login proprio da app em vez do sa
SQLSRV_HOST=192.168.20.203,1433
SQLSRV_USER=rouparia_app
SQLSRV_PASS=change-me
SQLSRV_DB=rouparia
ODBC_DRIVER=ODBC Driver 17 for SQL Server
SQLSRV_TRUST_CERT=yes   # em PRODUCTION=true tem de ser "no"

PRODUCTION=false
SECRET_KEY=change-me-with-at-least-32-random-chars   # python -c "import secrets;print(secrets.token_urlsafe(48))"
CORS_ORIGINS=["http://localhost:3040"]
